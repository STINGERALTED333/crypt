local function TryOpenNearbyDoor(Root)
    if not Root then return false end

    local NearestPrompt = nil
    local NearestDistance = math.huge

    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("ProximityPrompt")
            and Object.Enabled
            and not DoorPromptActivated[Object] then

            local Description = string.lower(
                tostring(Object.Name) .. " "
                .. tostring(Object.ActionText) .. " "
                .. tostring(Object.ObjectText)
            )

            local Parent = Object.Parent

            for Index = 1, 4 do
                if not Parent then break end
                Description = Description .. " " .. string.lower(Parent.Name)
                Parent = Parent.Parent
            end

            if Description:find("door")
                or Description:find("open")
                or Description:find("unlock") then

                local Position = GetPromptPosition(Object)

                if Position then
                    local Distance = (Root.Position - Position).Magnitude
                    local MaxDistance = math.max(Object.MaxActivationDistance + 2, 8)

                    if Distance <= MaxDistance and Distance < NearestDistance then
                        NearestDistance = Distance
                        NearestPrompt = Object
                    end
                end
            end
        end
    end

    if NearestPrompt then
        local Success = ActivatePrompt(NearestPrompt)

        if Success then
            DoorPromptActivated[NearestPrompt] = true
            return true
        end
    end

    return false
end

local function FollowPath(Humanoid, Root, Path, Destination, ArrivalRadius)
    ArrivalRadius = ArrivalRadius or 3

    local Waypoints = Path:GetWaypoints()

    if #Waypoints == 0 then
        return false
    end

    local Blocked = false
    local CurrentWaypointIndex = 1
    local ReachedDestination = false

    local BlockedConnection = Path.Blocked:Connect(function(BlockedIndex)
        if BlockedIndex >= CurrentWaypointIndex then
            Blocked = true
        end
    end)

    local Failed = false

    for Index, Waypoint in ipairs(Waypoints) do
        CurrentWaypointIndex = Index

        if not Running or not Root.Parent or not Humanoid.Parent then
            Failed = true
            break
        end

        if (Root.Position - Destination).Magnitude <= ArrivalRadius then
            ReachedDestination = true
            break
        end

        if Blocked then
            Failed = true
            break
        end

        local Offset = Waypoint.Position - Root.Position
        local InitialHorizontal = Vector3.new(Offset.X, 0, Offset.Z)

        -- Horizontal check: root sits ~3 studs above waypoint height
        if InitialHorizontal.Magnitude <= 2.75 then
            continue
        end

        local NeedsJump = Waypoint.Action == Enum.PathWaypointAction.Jump
            and (Offset.Y >= 1.5 or InitialHorizontal.Magnitude >= 5.5)

        local JumpIssued = false
        local LastPosition = Root.Position
        local LastProgress = os.clock()
        local StartedAt = os.clock()

        local Speed = math.max(Humanoid.WalkSpeed, 1)
        local Timeout = math.clamp(Offset.Magnitude / Speed * 3 + 2, 3, 15)

        while Running and Root.Parent and Humanoid.Parent do
            if Blocked then
                Failed = true
                break
            end

            if (Root.Position - Destination).Magnitude <= ArrivalRadius then
                ReachedDestination = true
                break
            end

            local CurrentOffset = Waypoint.Position - Root.Position
            local Horizontal = Vector3.new(CurrentOffset.X, 0, CurrentOffset.Z)

            -- Horizontal check here too
            if Horizontal.Magnitude <= 2.75 then
                break
            end

            if Horizontal.Magnitude > 0.1 then
                Humanoid:Move(Horizontal.Unit, false)
            else
                Humanoid:Move(Vector3.zero, false)
            end

            if NeedsJump and not JumpIssued
                and Horizontal.Magnitude > 0.5
                and Humanoid.FloorMaterial ~= Enum.Material.Air then

                Humanoid.Jump = true
                JumpIssued = true
            end

            if (Root.Position - LastPosition).Magnitude >= 0.3 then
                LastPosition = Root.Position
                LastProgress = os.clock()
            elseif os.clock() - LastProgress >= 1.5 then
                TryOpenNearbyDoor(Root)
                Failed = true
                break
            end

            if os.clock() - StartedAt >= Timeout then
                Failed = true
                break
            end

            RunService.Heartbeat:Wait()
        end

        if ReachedDestination or Failed then
            break
        end
    end

    BlockedConnection:Disconnect()
    Humanoid:Move(Vector3.zero, false)

    if ReachedDestination
        or (not Failed and Root.Parent
        and (Root.Position - Destination).Magnitude <= ArrivalRadius) then
        return true
    end

    return false
end

local function MoveToPosition(Destination, ArrivalRadius)
    ArrivalRadius = ArrivalRadius or 3

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid or not Root then
        return false
    end

    for Attempt = 1, 5 do
        if not Running or not Humanoid.Parent or not Root.Parent then
            return false
        end

        if (Root.Position - Destination).Magnitude <= ArrivalRadius then
            Humanoid:Move(Vector3.zero, false)
            return true
        end

        local Path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentJumpHeight = 8,
            WaypointSpacing = 4
        })

        local Computed = pcall(function()
            Path:ComputeAsync(Root.Position, Destination)
        end)

        if not Running then
            return false
        end

        if Computed and Path.Status == Enum.PathStatus.Success then
            if FollowPath(Humanoid, Root, Path, Destination, ArrivalRadius) then
                return true
            end
        else
            warn("[Auto] Path calculation failed.")
        end

        Humanoid:Move(Vector3.zero, false)
        task.wait(0.15)
    end

    return Root.Parent and (Root.Position - Destination).Magnitude <= ArrivalRadius
end

local RecordedWaypoints = nil
local RecordedLoaded = false

local function GetRecordedWaypoints()
    if RecordedLoaded then
        return RecordedWaypoints
    end

    RecordedLoaded = true

    local Data = nil

    if type(RECORDED_WAYPOINTS) == "table" and #RECORDED_WAYPOINTS > 0 then
        Data = RECORDED_WAYPOINTS
    elseif type(WAYPOINTS_URL) == "string"
        and WAYPOINTS_URL ~= ""
        and not WAYPOINTS_URL:find("USERNAME", 1, true) then

        local Ok, Result = pcall(function()
            local Source = game:HttpGet(WAYPOINTS_URL)
            local Compiled, CompileError = loadstring(Source)

            if not Compiled then
                error(CompileError)
            end

            return Compiled()
        end)

        if Ok and type(Result) == "table" and #Result > 0 then
            Data = Result
        else
            warn("[Auto] Could not load recorded waypoints: " .. tostring(Result))
        end
    end

    RecordedWaypoints = Data

    if Data then
        print("[Auto] Loaded " .. #Data .. " recorded waypoints.")
    else
        print("[Auto] No recorded waypoints. Using pathfinding.")
    end

    return Data
end

local function TriggerNearestPrompt(Root)
    local Nearest = nil
    local NearestDistance = math.huge

    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("ProximityPrompt")
            and Object.Enabled
            and not Object:FindFirstAncestor("Puddle") then

            local Position = GetPromptPosition(Object)

            if Position then
                local Distance = (Root.Position - Position).Magnitude

                if Distance <= Object.MaxActivationDistance and Distance < NearestDistance then
                    Nearest = Object
                    NearestDistance = Distance
                end
            end
        end
    end

    if Nearest then
        return ActivatePrompt(Nearest)
    end

    return false
end

local function WaypointVector(Waypoint)
    return Vector3.new(Waypoint[1], Waypoint[2], Waypoint[3])
end

local function FollowRecorded(Waypoints)
    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid or not Root then
        return false
    end

    -- Pick where to start on the route
    local StartIndex = 1

    if (Root.Position - WaypointVector(Waypoints[1])).Magnitude > 25 then
        local BestIndex = 1
        local BestDistance = math.huge

        for Index, Waypoint in ipairs(Waypoints) do
            local Distance = (Root.Position - WaypointVector(Waypoint)).Magnitude

            if Distance < BestDistance then
                BestIndex = Index
                BestDistance = Distance
            end
        end

        StartIndex = BestIndex

        if BestDistance > 25 then
            print("[Auto] Far from recorded route. Pathfinding to nearest route point.")

            if not MoveToPosition(WaypointVector(Waypoints[BestIndex]), 4) then
                return false
            end
        end
    end

    print("[Auto] Following recorded route from point " .. StartIndex .. "/" .. #Waypoints)

    for Index = StartIndex, #Waypoints do
        local Waypoint = Waypoints[Index]
        local Target = WaypointVector(Waypoint)
        local Kind = Waypoint[4] or 0
        local Radius = (Kind == 0) and 3 or 2

        local Jumped = false
        local LastPosition = Root.Position
        local LastProgress = os.clock()
        local StartedAt = os.clock()
        local Reached = false

        while Running and Root.Parent and Humanoid.Parent do
            local Offset = Target - Root.Position
            local Flat = Vector3.new(Offset.X, 0, Offset.Z)

            if Flat.Magnitude <= Radius and math.abs(Offset.Y) <= 6 then
                Reached = true
                break
            end

            if Flat.Magnitude > 0.1 then
                Humanoid:Move(Flat.Unit, false)
            end

            if (Root.Position - LastPosition).Magnitude >= 0.3 then
                LastPosition = Root.Position
                LastProgress = os.clock()
            elseif os.clock() - LastProgress >= 1.2 then
                -- Stuck: maybe a door is in the way
                TriggerNearestPrompt(Root)

                if os.clock() - LastProgress >= 2.5 then
                    Humanoid:Move(Vector3.zero, false)
                    warn("[Auto] Stuck on recorded route. Falling back to pathfinding.")
                    return false
                end
            end

            if os.clock() - StartedAt >= 8 then
                if (Root.Position - Target).Magnitude <= 8 then
                    Reached = true
                    break
                end

                Humanoid:Move(Vector3.zero, false)
                warn("[Auto] Timed out on recorded route. Falling back to pathfinding.")
                return false
            end

            RunService.Heartbeat:Wait()
        end

        if not Running or not Reached then
            Humanoid:Move(Vector3.zero, false)
            return false
        end

        if Kind == 1 and not Jumped and Humanoid.FloorMaterial ~= Enum.Material.Air then
            Humanoid.Jump = true
            Jumped = true
        elseif Kind == 2 then
            Humanoid:Move(Vector3.zero, false)
            TriggerNearestPrompt(Root)
            task.wait(0.15)
        end
    end

    Humanoid:Move(Vector3.zero, false)

    return (Root.Position - TARGET_CF.Position).Magnitude <= TARGET_START_RADIUS
end

local function RunToTarget()
    if not Running then return false end
    if not GetHumanoid() then return false end

    print("[Auto] Running to target. Activation radius: 14 studs.")

    local Reached = false
    local Waypoints = GetRecordedWaypoints()

    if Waypoints then
        Reached = FollowRecorded(Waypoints)
    end

    if not Reached and Running then
        Reached = MoveToPosition(TARGET_CF.Position, TARGET_START_RADIUS)
    end

    if Reached then
        print("[Auto] Within 14 studs of target. Starting collection.")
    else
        warn("[Auto] Could not reach target activation radius.")
    end

    return Reached
end

local function WalkTo(Puddle, Prompt)
    if not Puddle or not Puddle.Parent then
        return false
    end

    if not Prompt or not Prompt.Parent then
        return false
    end

    local MaxDistance = Prompt.MaxActivationDistance
    local Target = GetPosition(Puddle)

    -- 3D radius leaves room for the ~3 stud root height and stays inside prompt range
    local Radius = math.max(4, MaxDistance - 2)

    MoveToPosition(Target, Radius)

    local Root = GetRoot()
    local Position = GetPromptPosition(Prompt)

    return Root ~= nil
        and Position ~= nil
        and (Root.Position - Position).Magnitude <= MaxDistance
end

local function LoadBlacklist()
    local List = {}

    if type(isfile) == "function"
        and type(readfile) == "function"
        and isfile(BLACKLIST_FILE) then

        local Ok, Data = pcall(function()
            return HttpService:JSONDecode(readfile(BLACKLIST_FILE))
        end)

        if Ok and type(Data) == "table" then
            List = Data
        end
    end

    local Now = os.time()

    for Id, Time in pairs(List) do
        if type(Time) ~= "number" or Now - Time >= BLACKLIST_SECONDS then
            List[Id] = nil
        end
    end

    return List
end

local function SaveBlacklist(List)
    if type(writefile) == "function" then
        pcall(writefile, BLACKLIST_FILE, HttpService:JSONEncode(List))
    end
end

local function ServerHop()
    if not Running then return false end

    local Blacklist = LoadBlacklist()
    Blacklist[game.JobId] = os.time() -- never rejoin the server we're leaving (for 2 minutes)
    SaveBlacklist(Blacklist)

    local Url = "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local Success, Data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(Url))
    end)

    if not Running then return false end

    if not Success or type(Data) ~= "table" or type(Data.data) ~= "table" then
        warn("[Auto] Server lookup failed.")
        return false
    end

    local Candidates = {}

    for _, Server in ipairs(Data.data) do
        if Server.id
            and Server.id ~= game.JobId
            and not Blacklist[Server.id]
            and Server.playing
            and Server.maxPlayers
            and Server.playing < Server.maxPlayers then

            table.insert(Candidates, Server)
        end
    end

    table.sort(Candidates, function(A, B)
        return A.playing < B.playing
    end)

    if #Candidates == 0 then
        warn("[Auto] No non-blacklisted servers available.")
        return false
    end

    -- Pick randomly among the emptiest few so it doesn't always grab the same one
    local TargetServer = Candidates[math.random(1, math.min(5, #Candidates))]

    if not QueueSelf() or not Running then
        return false
    end

    print("[Auto] Hopping to server: " .. TargetServer.id)

    local TeleportSuccess, TeleportError = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            game.PlaceId,
            TargetServer.id,
            Player
        )
    end)

    if not TeleportSuccess then
        warn("[Auto] Teleport failed: " .. tostring(TeleportError))
        return false
    end

    return true
end

local function ProcessPuddle(Puddle)
    if not Puddle or not Puddle.Parent
        or ProcessedPuddles[Puddle]
        or IgnoredPuddles[Puddle] then
        return false
    end

    local Destroyed = false

    local DestroyConnection = Puddle.Destroying:Connect(function()
        Destroyed = true
    end)

    local Prompt = FindPuddlePrompt(Puddle)

    if not Prompt then
        DestroyConnection:Disconnect()
        return false
    end

    local Reached = WalkTo(Puddle, Prompt)

    if not Running then
        DestroyConnection:Disconnect()
        return false
    end

    local DidIt = false

    if Reached and not Destroyed and Puddle.Parent then
        Prompt = FindPuddlePrompt(Puddle)

        if Prompt then
            DidIt = ActivatePrompt(Prompt, Puddle)
        end
    end

    if Destroyed or not Puddle.Parent then
        ProcessedPuddles[Puddle] = true

    elseif DidIt then
        ProcessedPuddles[Puddle] = true
        print("[Auto] Puddle collected.")

    else
        PuddleFailures[Puddle] = (PuddleFailures[Puddle] or 0) + 1

        if PuddleFailures[Puddle] >= 3 then
            IgnoredPuddles[Puddle] = true
            ProcessedPuddles[Puddle] = true
            warn("[Auto] Puddle failed 3 times. Ignoring it.")
        else
            warn("[Auto] Interaction failed. Will retry on next cycle.")
        end
    end

    DestroyConnection:Disconnect()

    return DidIt
end


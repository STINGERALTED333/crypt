local function Track(Connection)
    table.insert(CurrentConnections, Connection)
    return Connection
end

local function CleanupConnections()
    for Index = #CurrentConnections, 1, -1 do
        local Connection = CurrentConnections[Index]
        if Connection and Connection.Connected then
            Connection:Disconnect()
        end
        table.remove(CurrentConnections, Index)
    end
end

local function HoldShift()
    if ShiftHeld then return true end

    if type(keypress) == "function" then
        local Success = pcall(keypress, 0x10)

        if Success then
            ShiftHeld = true
            ShiftMethod = "executor"
            return true
        end
    end

    local Success = pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    end)

    if Success then
        ShiftHeld = true
        ShiftMethod = "virtual"
        return true
    end

    warn("[Auto] Unable to hold Shift.")
    return false
end

local function ReleaseShift()
    if not ShiftHeld then return end

    if ShiftMethod == "executor" and type(keyrelease) == "function" then
        pcall(keyrelease, 0x10)
    else
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        end)
    end

    ShiftHeld = false
    ShiftMethod = nil
end

local function SetPlayerControlsEnabled(Enabled)
    if not PlayerControls then
        local Success, Controls = pcall(function()
            local PlayerScripts = Player:WaitForChild("PlayerScripts", 10)
            if not PlayerScripts then return nil end

            local PlayerModule = PlayerScripts:WaitForChild("PlayerModule", 10)
            if not PlayerModule then return nil end

            return require(PlayerModule):GetControls()
        end)

        if Success then
            PlayerControls = Controls
        end
    end

    if PlayerControls then
        pcall(function()
            if Enabled then
                PlayerControls:Enable()
            else
                PlayerControls:Disable()
            end
        end)
    end
end

local function GetRoot()
    local Character = Player.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()

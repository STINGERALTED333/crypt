-- Waits only the remaining part of the cooldown (walking time already counts toward it)
local function WaitForCooldown()
    local Remaining = INTERACTION_COOLDOWN - (os.clock() - LastInteraction)

    if Remaining > 0 then
        task.wait(Remaining)
    end
end

local function ActivatePrompt(Prompt, Puddle)
    if not Prompt or not Prompt.Parent or not Prompt:IsA("ProximityPrompt") then
        return false
    end

    if not Prompt.Enabled then
        warn("[Auto] Prompt is disabled.")
        return false
    end

    MakePromptInstant(Prompt)

    local Root = GetRoot()
    local Position = GetPromptPosition(Prompt)

    if not Root or not Position then
        return false
    end

    local Distance = (Root.Position - Position).Magnitude

    if Distance > Prompt.MaxActivationDistance then
        warn("[Auto] Too far from prompt: " .. string.format("%.1f", Distance) .. " studs.")
        return false
    end

    local TriggerObserved = false

    -- Any trigger counts, no filtering on who triggered it
    local TriggerConnection = Prompt.Triggered:Connect(function()
        TriggerObserved = true
    end)

    -- Some puddles delete or disable their prompt the moment they are used,
    -- so that also counts as a successful interaction.
    local function IsConsumed()
        return TriggerObserved
            or not Prompt.Parent
            or not Prompt.Enabled
            or (Puddle ~= nil and not Puddle.Parent)
    end

    local Fired = false

    for Attempt = 1, 3 do
        if not Running then
            break
        end

        if Fired and IsConsumed() then
            break
        end

        WaitForCooldown()

        if not Running or not Prompt.Parent or not Prompt.Enabled then
            break
        end

        print("[Auto] Firing prompt " .. Attempt .. "/3")
        LastInteraction = os.clock()

        if type(fireproximityprompt) == "function" then
            local Success, Err = pcall(fireproximityprompt, Prompt)

            if not Success then
                warn("[Auto] fireproximityprompt failed: " .. tostring(Err))
                break
            end
        else
            if not PressE() then
                break
            end
        end

        Fired = true

        local StartedAt = os.clock()

        while Running and not IsConsumed() and os.clock() - StartedAt < 0.5 do
            task.wait(0.03)
        end

        if IsConsumed() then
            break
        end
    end

    TriggerConnection:Disconnect()

    if Fired and IsConsumed() then
        print("[Auto] Puddle interaction confirmed.")
        return true
    end

    warn("[Auto] Prompt fired, but no trigger confirmed.")
    return false
end

local function Stop()
    if not Running then return end

    Running = false

    local Root = GetRoot()
    local Humanoid = GetHumanoid()

    if Humanoid then
        Humanoid:Move(Vector3.zero, false)

        if Root then
            Humanoid:MoveTo(Root.Position)
        end
    end

    CleanupConnections()
    ReleaseShift()
    SetPlayerControlsEnabled(true)
    RestorePrompts()

    for StoredHumanoid, State in pairs(WalkSpeedStates) do
        if StoredHumanoid and StoredHumanoid.Parent then
            StoredHumanoid.WalkSpeed = State.Original
        end
    end

    pcall(function()
        if typeof(script) == "Instance" and script:IsA("BaseScript") then
            script:Destroy()
        end
    end)

    warn("[Auto] Stopped. Controls restored.")
end


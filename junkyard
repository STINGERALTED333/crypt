    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function ApplyWalkSpeedBoost()
    local Humanoid = GetHumanoid()
    if not Humanoid then return end

    local State = WalkSpeedStates[Humanoid]

    if not State then
        State = {
            Original = Humanoid.WalkSpeed,
            Base = Humanoid.WalkSpeed,
            LastApplied = nil
        }

        WalkSpeedStates[Humanoid] = State
    end

    if State.LastApplied and math.abs(Humanoid.WalkSpeed - State.LastApplied) > 0.05 then
        State.Base = Humanoid.WalkSpeed
    end

    local BoostedSpeed = State.Base + WALK_SPEED_BOOST

    if math.abs(Humanoid.WalkSpeed - BoostedSpeed) > 0.05 then
        Humanoid.WalkSpeed = BoostedSpeed
    end

    State.LastApplied = BoostedSpeed
end

local function MakePromptInstant(Prompt)
    if not Prompt or not Prompt:IsA("ProximityPrompt") then
        return false
    end

    if OriginalPromptStates[Prompt] == nil then
        OriginalPromptStates[Prompt] = {
            HoldDuration = Prompt.HoldDuration
        }
    end

    return pcall(function()
        Prompt.HoldDuration = 0
    end)
end

local function RestorePrompts()
    for Prompt, State in pairs(OriginalPromptStates) do
        if Prompt and Prompt.Parent then
            pcall(function()
                Prompt.HoldDuration = State.HoldDuration
            end)
        end
    end

    table.clear(OriginalPromptStates)
end

local function FindPuddlePrompt(Puddle)
    if not Puddle or not Puddle.Parent then
        return nil
    end

    for _, Object in ipairs(Puddle:GetDescendants()) do
        if Object:IsA("ProximityPrompt") and Object.Enabled then
            MakePromptInstant(Object)
            return Object
        end
    end

    return nil
end

local function GetPromptPosition(Prompt)
    if not Prompt or not Prompt.Parent then
        return nil
    end

    local Parent = Prompt.Parent

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    elseif Parent:IsA("BasePart") then
        return Parent.Position
    elseif Parent:IsA("Model") then
        return Parent:GetPivot().Position
    end

    while Parent and Parent ~= workspace do
        if Parent:IsA("BasePart") then
            return Parent.Position
        end
        Parent = Parent.Parent
    end

    return nil
end

